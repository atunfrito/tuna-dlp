{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tuna-dlp",
  "version": "1.1.0",
  "identifier": "es.atunfrito.tunadlp",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "AtunFrito",
    "homepage": "https://atunfrito.es",
    "copyright": "AtunFrito",
    "category": "Utility",
    "shortDescription": "Descarga vídeos y audio con yt-dlp",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../THIRD-PARTY-NOTICES.es.md": "THIRD-PARTY-NOTICES.es.md",
      "../licenses/*": "licenses/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/ganchos.nsh",
        "compression": "lzma"
      }
    }
  }
}
